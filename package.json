{
  "name": "hmss-desktop",
  "version": "1.0.8",
  "description": "Local-first hospital management system",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "pack": "electron-builder --win nsis --x64",
    "publish": "electron-builder --win nsis --x64 --publish always && node scripts/ensure-update-metadata.cjs"
  },
  "devDependencies": {
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron@44.9.1": true
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "firebase": "^13.1.0",
    "jsbarcode": "^3.12.1",
    "three": "^0.160.1"
  },
  "build": {
    "appId": "com.kabirhat.privatehospital",
    "productName": "Kabirhat Private Hospital & Normal Delivery Center",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "js/**/*",
      "styles/**/*",
      "UI/**/*",
      "site_assets/**/*",
      "Firebase_sdks/**/*",
      "firebase/**/*",
      "package.json"
    ],
    "win": {
      "icon": "site_assets/Hospital_Logo.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Kabirhat-Private-Hospital-Normal-Delivery-Center-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "ceo-uploads",
      "repo": "HMS",
      "releaseType": "release",
      "publishAutoUpdate": true
    }
  }
}
